+    """
+
+    prepared, records_by_id = _prepare_records(records)
+    known_ids = set(records_by_id)
+
+    changed = _validate_id_list(changed_ids, "changed_ids", known_ids)
+    if immediate_ids is None:
+        immediate = []
+    else:
+        immediate = _validate_id_list(immediate_ids, "immediate_ids", known_ids)
+
+    if query is not None and not isinstance(query, str):
+        raise ValueError("query must be a string or None")
+
+    pages: Dict[SemanticKey, _Page] = {}
