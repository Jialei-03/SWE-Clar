+_MAX_AUDIO_BYTES = 1024 * 1024
+
+
+def _is_finite_number(value):
+    """Return whether *value* is a JSON-like finite number, not a bool."""
+    if isinstance(value, bool) or not isinstance(value, (int, float)):
+        return False
+    try:
+        return math.isfinite(value)
+    except (TypeError, ValueError, OverflowError):
+        return False
+
+
+def _nonempty_string(value, *, strip=False):
+    if not isinstance(value, str) or not value:
+        return False
+    return bool(value.strip()) if strip else True
+
+
+def _finish_error(out, code):
+    """Put the deliberately small public error shape on a result state."""
+    out["error"] = {"code": code or "invalid_event"}
     return out
+
+
+def _finish_result(out, result):
+    out["result"] = result
+    return out
+
+
+def _room_from_state(out, event):
+    """Look up an existing room without changing the copied state."""
+    rooms = out.get("rooms")
+    room_id = event.get("room_id")
+    if not isinstance(rooms, dict) or not _nonempty_string(room_id, strip=True):
+        return None
+    return rooms.get(room_id)
+
+
+def _room_lists(room):
+    """Return the participant and locked lists when the room is well formed."""
+    if not isinstance(room, dict):
+        return None
+    participants = room.get("participants")
+    locked = room.get("locked")
+    if not isinstance(participants, list) or not isinstance(locked, list):
+        return None
+    return participants, locked
+
+
+def _room_turn_limit(room):
+    if not isinstance(room, dict):
+        return None
+    value = room.get("turn_limit")
+    if not _is_finite_number(value) or value <= 0:
+        return None
+    return value
+
+
+def _server_time(event):
+    value = event.get("server_time")
+    return value if _is_finite_number(value) else None
+
+
+def _next_unlocked(participants, locked, cursor):
+    """Select the first unlocked participant after ``cursor`` circularly.
+
+    ``cursor`` is the last participant whose turn was selected.  Keeping it
+    even while a turn is released is what makes a locked current speaker's
+    next turn resume after that speaker.
+    """
+    if not participants:
+        return None
+
+    # A valid room has unique participants.  The defensive fallback also
+    # gives deterministic behavior for a hand-built state with a stale cursor.
+    if cursor in participants:
+        start = (participants.index(cursor) + 1) % len(participants)
+    else:
+        start = 0
+
+    locked_set = set()
+    for user in locked:
+        try:
+            locked_set.add(user)
+        except TypeError:
+            # Malformed participant data is not a selectable user.
+            pass
+
+    for offset in range(len(participants)):
+        candidate = participants[(start + offset) % len(participants)]
+        if candidate not in locked_set:
+            return candidate
+    return None
+
+
+def _current_is_valid(room, participants, locked):
+    current = room.get("current")
+    return (current is None or
+            (current in participants and current not in locked))
+
+
+def _rotate(room, participants, locked, server_time, *, from_current=True):
+    """Apply one turn selection to a copied room.
+
+    The caller has already validated the event.  A tuple is returned so an
+    overflowing deadline can still be rejected before any room mutation.
+    """
+    current = room.get("current")
+    cursor = room.get("cursor")
+
+    # Current is authoritative when a caller is operating on a room made by
+    # an older state shape that did not yet contain the cursor field.
+    if from_current and current is not None:
+        cursor = current
+
+    selected = _next_unlocked(participants, locked, cursor)
+    if selected is None:
+        return None, None, cursor
+
+    limit = _room_turn_limit(room)
+    if limit is None:
+        return None, None, cursor
+    deadline = server_time + limit
+    if not _is_finite_number(deadline):
+        return None, None, cursor
+    return selected, deadline, selected
+
