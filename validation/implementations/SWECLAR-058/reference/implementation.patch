+def _audio_bytes(audio_base64):
+    """Decode and validate the complete WAV payload, returning raw bytes.
+
+    The caller retains the original base64 text for the result; the canonical
+    encoding returned here is only used to compare packet replays by their
+    actual bytes.
+    """
+    if not isinstance(audio_base64, str) or not audio_base64:
+        return None
+
+    # Reject absurd input before decoding.  This is both a useful guard for a
+    # direct caller and keeps the HTTP endpoint's bounded request useful.
+    max_encoded = 4 * ((_MAX_AUDIO_BYTES + 2) // 3) + 4
+    if len(audio_base64) > max_encoded:
+        return None
+
+    try:
+        raw = base64.b64decode(audio_base64, validate=True)
+    except (ValueError, TypeError, UnicodeError):
+        return None
+    if not raw or len(raw) > _MAX_AUDIO_BYTES:
+        return None
+
+    try:
+        with wave.open(io.BytesIO(raw), "rb") as wav_file:
+            if (wav_file.getnchannels() != 1 or
+                    wav_file.getsampwidth() != 2 or
+                    wav_file.getframerate() != 8000 or
+                    wav_file.getcomptype() != "NONE"):
+                return None
+            frame_count = wav_file.getnframes()
+            if frame_count <= 0:
+                return None
+            frames = wav_file.readframes(frame_count)
+            # For mono 16-bit PCM every declared frame is exactly two bytes.
+            # This catches a WAV whose data chunk was truncated.
+            if len(frames) != frame_count * 2:
+                return None
+    except Exception:
+        # ``wave`` has a few format-dependent parsing paths; any malformed
+        # chunk is simply an invalid payload, never a server-fatal event.
+        return None
+
+    return raw
+
+
+def _packet_records(room):
+    records = room.get("packets", {})
+    return records if isinstance(records, dict) else None
+
+
+def _create_room(out, event):
+    rooms = out.get("rooms")
+    if not isinstance(rooms, dict):
+        return _finish_error(out, "invalid_room")
+
+    room_id = event.get("room_id")
+    limit = event.get("turn_limit")
+    private = event.get("private", False)
+    token = event.get("access_token", "")
+
+    try:
+        known_admin = event.get("admin_id") in out.get("admins", [])
+    except (TypeError, AttributeError):
+        known_admin = False
+
+    valid = (
+        known_admin and
+        _nonempty_string(room_id, strip=True) and
+        room_id not in rooms and
+        isinstance(private, bool) and
+        _is_finite_number(limit) and limit > 0 and
+        (not private or (_nonempty_string(token) and isinstance(token, str)))
+    )
+    if not valid:
+        return _finish_error(out, "invalid_room")
+
+    # ``packets`` and ``cursor`` are application metadata.  They are kept in
+    # the room so replay checks remain scoped to this room and survive the
+    # stateless process_voice_event call boundary.
+    rooms[room_id] = {
+        "private": private,
+        "access_token": token,
+        "turn_limit": limit,
+        "participants": [],
+        "locked": [],
+        "current": None,
+        "deadline": None,
+        "cursor": None,
+        "packets": {},
+    }
+    return _finish_result(out, {"room_id": room_id})
+
+
+def _join(out, event):
+    room = _room_from_state(out, event)
+    lists = _room_lists(room)
+    user_id = event.get("user_id")
+    if room is None or lists is None or not _nonempty_string(user_id, strip=True):
+        return _finish_error(out, "invalid_join")
+    participants, locked = lists
+
+    if room.get("private") is True:
+        if event.get("access_token") != room.get("access_token"):
+            return _finish_error(out, "invalid_join")
+    elif room.get("private") is not False:
+        return _finish_error(out, "invalid_join")
+
+    if user_id not in participants:
+        participants.append(user_id)
+    return _finish_result(out, {"participants": list(participants)})
+
+
+def _lock_or_unlock(out, event, *, lock):
+    room = _room_from_state(out, event)
+    lists = _room_lists(room)
+    user_id = event.get("user_id")
+    if room is None or lists is None or not _nonempty_string(user_id, strip=True):
+        return _finish_error(out, "invalid_pass_lock")
+    participants, locked = lists
+    if user_id not in participants:
+        return _finish_error(out, "invalid_pass_lock")
+
+    if lock:
+        if user_id not in locked:
+            locked.append(user_id)
+        if room.get("current") == user_id:
+            # Preserve the cursor.  The next advance starts after this user.
+            room["cursor"] = user_id
+            room["current"] = None
+            room["deadline"] = None
+    else:
+        # Removing all occurrences is harmless for a normal state and repairs
+        # a duplicate in a synthetic hand-built state without changing order.
+        locked[:] = [value for value in locked if value != user_id]
+
+    return _finish_result(out, {"locked": user_id in locked})
+
+
+def _advance(out, event, *, mode):
+    room = _room_from_state(out, event)
+    lists = _room_lists(room)
+    when = _server_time(event)
+    if room is None or lists is None or when is None:
+        return _finish_error(out, "invalid_turn")
+    participants, locked = lists
+
+    if not _current_is_valid(room, participants, locked):
+        return _finish_error(out, "invalid_turn")
+
+    current = room.get("current")
+    if mode == "pass":
+        user_id = event.get("user_id")
+        if (not _nonempty_string(user_id, strip=True) or
+                current is None or user_id != current or
+                user_id not in participants or user_id in locked):
+            return _finish_error(out, "invalid_turn")
+    elif mode == "timeout":
+        deadline = room.get("deadline")
+        if (current is None or not _is_finite_number(deadline) or
+                when < deadline):
+            return _finish_error(out, "invalid_turn")
+    elif mode != "advance":
+        return _finish_error(out, "invalid_turn")
+
+    # A normal current turn is rotated after the current speaker.  On a new or
+    # released room, the stored cursor supplies the starting point.
+    selected, deadline, cursor = _rotate(room, participants, locked, when)
+    if selected is None and participants and any(value not in locked for value in participants):
+        # This can only be a malformed numeric turn limit/overflow; do not
+        # partially update the room.
+        return _finish_error(out, "invalid_turn")
+
+    room["current"] = selected
+    room["deadline"] = deadline
+    if selected is not None:
+        room["cursor"] = cursor
+
+    return _finish_result(out, {"current": selected, "deadline": deadline})
+
+
+def _audio(out, event):
+    room = _room_from_state(out, event)
+    lists = _room_lists(room)
+    when = _server_time(event)
+    user_id = event.get("user_id")
+    packet_id = event.get("packet_id")
+    encoded = event.get("audio_base64")
+
+    if (room is None or lists is None or when is None or
+            not _nonempty_string(user_id, strip=True) or
+            not _nonempty_string(packet_id, strip=True)):
+        return _finish_error(out, "invalid_audio")
+    participants, locked = lists
+    current = room.get("current")
+    deadline = room.get("deadline")
+    if (current is None or current != user_id or user_id not in participants or
+            user_id in locked or not _is_finite_number(deadline) or
+            when >= deadline):
+        return _finish_error(out, "invalid_audio")
+
+    raw = _audio_bytes(encoded)
+    if raw is None:
+        return _finish_error(out, "invalid_audio")
+    canonical = base64.b64encode(raw).decode("ascii")
+
+    records = _packet_records(room)
+    if records is None:
+        return _finish_error(out, "invalid_audio")
+    previous = records.get(packet_id)
+    if previous is not None:
+        if (isinstance(previous, dict) and
+                previous.get("sender") == user_id and
+                previous.get("audio_base64") == canonical):
+            return _finish_result(out, {
+                "packet_id": packet_id,
+                "audio_base64": encoded,
+                "recipients": [],
+            })
+        return _finish_error(out, "invalid_audio")
+
+    recipients = []
+    seen = set()
+    for participant in participants:
+        if participant == user_id:
+            continue
+        try:
+            already_seen = participant in seen
+        except TypeError:
+            return _finish_error(out, "invalid_audio")
+        if not already_seen:
+            try:
+                seen.add(participant)
+            except TypeError:
+                return _finish_error(out, "invalid_audio")
+            recipients.append(participant)
+
+    # All validation, including replay detection, is complete before this
+    # first mutation.  The record is JSON serializable because raw bytes never
+    # enter the returned state.
+    updated_records = dict(records)
+    updated_records[packet_id] = {
+        "sender": user_id,
+        "audio_base64": canonical,
+    }
+    room["packets"] = updated_records
+
+    return _finish_result(out, {
+        "packet_id": packet_id,
+        "audio_base64": encoded,
+        "recipients": recipients,
+    })
+
