+def process_voice_event(state: dict, event: dict) -> dict:
+    """Process one room event and return a new state.
+
+    No branch writes to ``state`` or ``event``.  In particular, validation is
+    performed before room mutation, so failed actions retain the copied room
+    data exactly as supplied by the caller.
+    """
+    try:
+        out = deepcopy(state)
+    except Exception:
+        # The documented interface supplies dictionaries.  This fallback keeps
+        # malformed direct calls in the required error shape without ever
+        # attempting to modify the object supplied by the caller.
+        out = {}
+
+    if not isinstance(out, dict):
+        return {"error": {"code": "invalid_state"}}
+
+    # Results and errors describe only the latest event.  Room data and all
+    # other application fields are retained in the copied state.
+    out.pop("error", None)
+    out.pop("result", None)
+    if "rooms" not in out:
+        out["rooms"] = {}
+
+    if not isinstance(event, dict):
+        return _finish_error(out, "invalid_event")
+
+    action = event.get("type")
+    if action == "create_room":
+        return _create_room(out, event)
+    if action == "join":
+        return _join(out, event)
+    if action == "lock_pass":
+        return _lock_or_unlock(out, event, lock=True)
+    if action == "unlock_pass":
+        return _lock_or_unlock(out, event, lock=False)
+    if action == "advance":
+        return _advance(out, event, mode="advance")
+    if action == "pass":
+        return _advance(out, event, mode="pass")
+    if action == "timeout":
+        return _advance(out, event, mode="timeout")
+    if action == "audio":
+        return _audio(out, event)
+    return _finish_error(out, "unknown_action")
