+        except Error as error:
+            self.send(error.status, {"error": error.code})
+        except (TypeError, OverflowError, ValueError):
+            self.send(400, {"error": "invalid_request"})
+        except Exception:
+            self.send(500, {"error": "server_error"})
+
+
+server = ThreadingHTTPServer(
