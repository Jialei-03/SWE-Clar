+            if path == "/checkout":
+                return self.send(200, store.checkout(actor["id"]))
+            if path == "/logout":
+                result = store.logout(self.token())
+                return self.send(
+                    200,
+                    result,
+                    {
+                        "Set-Cookie": (
+                            "session=; Max-Age=0; Path=/; HttpOnly; "
