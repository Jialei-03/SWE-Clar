+    def do_POST(self) -> None:  # noqa: N802 - required by BaseHTTPRequestHandler
+        try:
+            action = self.read_json()
+            if not isinstance(action, dict):
+                raise Error("invalid_request")
+            path = urlsplit(self.path).path
