+    def catalog_order(rows, descending):
+        """Order already-filtered routes with stable pin precedence.
+
+        Python's stable sort retains the input (creation) order for equal
+        folded titles, including when the comparison direction is reversed.
+        Keeping the groups separate makes pinning a personal partition rather
+        than another title-sort key.
+        """
+        groups = {True: [], False: []}
+        for row in rows:
+            groups[row['pinned']].append(row)
