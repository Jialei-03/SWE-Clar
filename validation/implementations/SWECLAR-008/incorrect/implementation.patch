+
+RULE_KINDS = {
+    "fridge_open",
+    "bathroom_occupied_day",
+    "bathroom_occupied_night",
+    "no_occupancy",
+    "exterior_open_night",
+}
+SEVERITIES = {"info", "warning", "critical"}
+DAY_MS = 24 * 60 * 60 * 1000
+MINUTE_MS = 60 * 1000
+
+
+def homes(db, user):
