+<?php if ($seo): ?>
+    <meta name="description" content="<?= e($seo['description'] ?? '') ?>">
+    <link rel="canonical" href="<?= e($seo['canonical_path'] ?? '') ?>">
+    <meta name="robots" content="<?= (($seo['indexable'] ?? false) === true) ? 'index,follow' : 'noindex,nofollow' ?>">
