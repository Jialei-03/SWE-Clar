+        <h1><?= e($title) ?></h1>
+    </header>
+    <p class="intro"><?= e($body) ?></p>
+    <div class="assets">
+<?php foreach ($images as $image): ?>
+        <?php if (is_array($image) && isset($image['data'])): ?>
+        <img alt="<?= e($image['id'] ?? '') ?>" src="<?= e($image['data']) ?>">
+        <?php endif; ?>
+<?php endforeach; ?>
+    </div>
+    <div class="sections">
+<?php foreach ($sections as $index => $section): ?>
+        <section>
+            <span><?= e($index + 1) ?></span>
+            <h2><?= e($section) ?></h2>
+        </section>
+<?php endforeach; ?>
+    </div>
+</main>
+</body>
+</html>
