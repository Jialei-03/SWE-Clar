+/// Makes a JSON-shaped map independent of the map supplied by its caller.
+///
+/// State is intentionally represented as JSON data rather than model classes.
+/// Copying the JSON graph directly keeps maps and lists detached without
+/// making the controller depend on a serialization round trip for its in
+/// memory snapshots.  The file store still serializes the state at its
+/// persistence boundary.
+Map<String, dynamic> clone(Map<String, dynamic> value) {
+  return _copyMap(value);
+}
+
+Map<String, dynamic> _copyMap(Map value) {
+  final result = <String, dynamic>{};
+  for (final entry in value.entries) {
+    // Public state and action maps are JSON-shaped, so their object keys are
+    // strings.  Keeping that invariant explicit also gives callers the same
+    // map type at every nested level.
+    result[entry.key as String] = _copyJsonValue(entry.value);
+  }
+  return result;
+}
+
+dynamic _copyJsonValue(dynamic value) {
+  if (value is Map) return _copyMap(value);
+  if (value is List) {
+    return <dynamic>[for (final item in value) _copyJsonValue(item)];
+  }
+  return value;
+}
