+            "SELECT * FROM interviews WHERE interview_id=?", (body["interview_id"],)
+        ).fetchone()
+        return {"interview": _interview_public(row), "duplicate": False}
+
+    if method == "GET" and path == "/api/calendar":
+        fields(query, [])
