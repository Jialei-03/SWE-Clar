+        for row in rows:
+            result.append(
+                {
+                    "interview_id": row["interview_id"],
+                    "application_id": row["application_id"],
+                    "job_id": row["job_id"],
+                    "job_title": row["job_title"],
+                    "participants": [row["employer_id"], row["employee_id"]],
+                    "start_ms": row["start_ms"],
+                    "end_ms": row["end_ms"],
+                }
+            )
+        return {"interviews": result}
+
+    return None
