+        require(app["status"] != "rejected", "conflict", 409)
+
+        overlap = db.execute(
+            """SELECT 1
+               FROM interviews AS i
+               JOIN applications AS a ON a.application_id=i.application_id
+               JOIN jobs AS j ON j.job_id=a.job_id
