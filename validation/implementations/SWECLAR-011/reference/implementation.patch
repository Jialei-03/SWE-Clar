+         FROM sessions s JOIN accounts a ON a.id = s.actor_id
+         WHERE s.token = :token',
+        ['token' => $token]
+    );
+    if ($user === null) {
+        fail(401, 'authentication_required', 'An active session is required.');
+    }
+    return ['id' => (string) $user['id'], 'role' => (string) $user['role']];
+}
