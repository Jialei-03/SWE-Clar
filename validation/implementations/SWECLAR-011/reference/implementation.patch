+    fail(404, 'not_found');
+} catch (ApiError $exception) {
+    jsonResponse([
+        'error' => [
+            'code' => $exception->kind,
+            'message' => $exception->getMessage(),
+        ],
+    ], $exception->status);
+} catch (Throwable $exception) {
