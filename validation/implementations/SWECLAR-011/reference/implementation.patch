+        fail(400, 'invalid_asset', 'The uploaded image is invalid or too large.');
+    }
+    $dimensions = inspectPng($data);
+    if ($dimensions === null) {
+        fail(400, 'invalid_asset', 'The upload must be a genuine PNG between 8 and 1024 pixels per side.');
+    }
