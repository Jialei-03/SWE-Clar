+function stopSynth(){
+  audioSerial+=1;
+  const oldVoices=voices;
+  voices=[];
+  for(const voice of oldVoices){
+    try{voice.osc.stop();}catch{}
+    try{voice.osc.disconnect();}catch{}
+    try{voice.gain.disconnect();}catch{}
+  }
