+function buildExportMidi(){
+  if(!sourceBytes)throw makeError('no_chart','load a chart first');
+  let midi;
+  try{
+    midi=new Midi(sourceBytes.slice().buffer);
+  }catch{
+    throw makeError('invalid_midi','current MIDI cannot be exported');
+  }
+  for(const track of midi.tracks){
+    for(const note of track.notes){
+      const pitch=note.midi+acceptedOffset;
+      if(!Number.isInteger(pitch)||pitch<0||pitch>127)throw makeError('invalid_transposition','current score contains an out-of-range MIDI note');
+      note.midi=pitch;
+    }
+  }
+  return midi.toArray();
+}
