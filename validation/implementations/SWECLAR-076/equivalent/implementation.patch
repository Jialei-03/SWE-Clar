-"""Independent portal game policy starter."""
+"""Pure event reducer for the independent portal training arena.
+
+The browser keeps the scenario as JSON and sends one action at a time.  This
+module treats each action as a transaction: validation reads the old snapshot,
+then a handler works on a deep copy and returns a small result summary.  The
+policy is deliberately independent of the renderer, so the same transitions
+are used by the HTTP server and by direct Python callers.
+"""
+
+from __future__ import annotations
+
+from copy import deepcopy
+import math
+from numbers import Integral
+from typing import Any, Mapping
+
+
+_AXES = ("x", "y", "z")
+_MODES = frozenset(("room", "cockpit"))
+_SUPPORTED_EVENTS = frozenset(
+    (
+        "transition",
+        "move_asteroid",
+        "equip",
+        "activate_shield",
+        "hit",
+        "fire",
+        "spawn_wave",
+    )
+)
+
+# A handler returns (new_state, result, error_code).  Only one of the first
+# two alternatives is used: errors are converted into a copy of the original
+# state by process_portal_event, while successful handlers return a transaction
+# that has already received its accepted timestamp.
+_HandlerOutcome = tuple[dict[str, Any] | None, dict[str, Any] | None, str | None]
+
+
+def _finite_number(value: Any) -> bool:
+    """Whether *value* is a finite JSON-style number, not a boolean."""
+
+    # bool is an Integral in Python, but it is not a numeric quantity in the
+    # event schema.  math.isfinite rejects strings, None, complex values, NaN,
+    # and infinities without accepting truthiness as a substitute.
+    if isinstance(value, bool):
+        return False
+    try:
+        return math.isfinite(value)
+    except (TypeError, ValueError, OverflowError):
+        return False
+
+
+def _positive_number(value: Any) -> bool:
+    if not _finite_number(value):
+        return False
+    try:
+        return value > 0
+    except (TypeError, ValueError):
+        return False
+
+
+def _nonnegative_number(value: Any) -> bool:
+    if not _finite_number(value):
+        return False
+    try:
+        return value >= 0
+    except (TypeError, ValueError):
+        return False
+
+
+def _mapping_value(mapping: Any, key: Any) -> tuple[bool, Any]:
+    """Safely find an identifier in a JSON object."""
+
+    if not isinstance(mapping, Mapping):
+        return False, None
+    try:
+        return (True, mapping[key]) if key in mapping else (False, None)
+    except (KeyError, TypeError):
+        # An unhashable or otherwise malformed identifier is an unknown one.
+        return False, None
+
+
+def _xyz(value: Any, *, positive: bool = False) -> tuple[bool, dict[str, Any]]:
+    """Validate and copy exactly the three coordinates used by the scene."""
+
+    if not isinstance(value, Mapping):
+        return False, {}
+    coordinates: dict[str, Any] = {}
+    for axis in _AXES:
+        if axis not in value:
+            return False, {}
+        component = value[axis]
+        valid = _positive_number(component) if positive else _finite_number(component)
+        if not valid:
+            return False, {}
+        coordinates[axis] = component
+    return True, coordinates
+
+
+def _error_state(state: Any, code: str) -> dict[str, Any]:
+    """Return an independent rejection carrying a non-empty error code."""
+
+    result = deepcopy(state) if isinstance(state, dict) else {}
+    result["error"] = {"code": code}
+    return result
+
+
+def _event_log_ok(state: Mapping[str, Any]) -> bool:
+    # Small synthetic states may omit the optional log; a supplied log must be
+    # mutable-list-shaped because successful effects append to it.
+    return "events" not in state or isinstance(state.get("events"), list)
+
+
+def _distinct(values: list[Any]) -> list[Any]:
+    """Preserve first-seen order while comparing IDs without hashing them."""
+
+    result: list[Any] = []
+    for value in values:
+        if not any(value == previous for previous in result):
+            result.append(value)
+    return result
+
+
+def _valid_wave(value: Any) -> bool:
+    return isinstance(value, Integral) and not isinstance(value, bool) and value >= 0
+
+
+def _transaction(state: dict[str, Any], timestamp: Any) -> dict[str, Any]:
+    """Clone a state and clear transport-only fields before committing."""
+
+    result = deepcopy(state)
+    # The HTTP server stores rejection responses as its current state.  A later
+    # accepted action should not turn that transport error into gameplay data.
+    result.pop("error", None)
+    result.pop("result", None)
+    result["timestamp"] = timestamp
+    return result
+
+
+def _finish(state: dict[str, Any], result: dict[str, Any]) -> dict[str, Any]:
+    state["result"] = deepcopy(result)
+    return state
+
+
+def _reject(code: str) -> _HandlerOutcome:
+    return None, None, code
+
+
+def _accept(state: dict[str, Any], result: dict[str, Any]) -> _HandlerOutcome:
+    return state, result, None
+
+
+def _reset_level(state: dict[str, Any]) -> bool:
+    """Restore the level snapshot after the final life is consumed.
+
+    This helper validates the copied state before assigning anything.  The
+    caller has already checked these fields on the source state, but the
+    second check keeps the reset atomic if the schema is extended later.
+    """
+
+    initial_lives = state.get("initial_lives")
+    snapshot = state.get("level_asteroids")
+    if snapshot is None:
+        snapshot = state.get("asteroids", {})
+    current_wave = state.get("wave", 0)
+    enemies = state.get("enemies", {})
+    restart_count = state.get("restart_count", 0)
+
+    if not _nonnegative_number(initial_lives):
+        return False
+    if not isinstance(snapshot, Mapping) or not _valid_wave(current_wave):
+        return False
+    if not isinstance(enemies, dict):
+        return False
+    if not isinstance(restart_count, Integral) or isinstance(restart_count, bool):
+        return False
+    if not _event_log_ok(state):
+        return False
+    if any(not isinstance(enemy, dict) for enemy in enemies.values()):
+        return False
+
+    # All writes below target the private transaction, never the caller's
+    # state.  A current wave's synthetic enemies all use wave + 1 health.
+    state["lives"] = initial_lives
+    state["shield_energy"] = 0
+    state["asteroids"] = deepcopy(snapshot)
+    full_health = current_wave + 1
+    for enemy in enemies.values():
+        enemy["hp"] = full_health
+    state["restart_count"] = restart_count + 1
+    state.setdefault("events", []).append({"type": "level_restart"})
+    return True
+
+
+def _transition(state: dict[str, Any], event: dict[str, Any], timestamp: Any) -> _HandlerOutcome:
+    mode = state.get("mode")
+    target = event.get("target_mode")
+    if (
+        not isinstance(mode, str)
+        or not isinstance(target, str)
+        or mode not in _MODES
+        or target not in _MODES
+        or target == mode
+    ):
+        return _reject("invalid_mode")
+
+    found, portal = _mapping_value(state.get("portals"), event.get("portal_id"))
+    if not found or not isinstance(portal, Mapping) or portal.get("active") is not True:
+        return _reject("invalid_portal")
+
+    updated = _transaction(state, timestamp)
+    updated["mode"] = target
+    return _accept(updated, {"mode": target, "lives": deepcopy(updated.get("lives"))})
+
+
+def _move_asteroid(state: dict[str, Any], event: dict[str, Any], timestamp: Any) -> _HandlerOutcome:
+    asteroid_id = event.get("asteroid_id")
+    found, asteroid = _mapping_value(state.get("asteroids"), asteroid_id)
+    if not found or not isinstance(asteroid, Mapping):
+        return _reject("unknown_asteroid")
+
+    position_ok, position = _xyz(asteroid.get("position"))
+    velocity_ok, velocity = _xyz(asteroid.get("velocity"))
+    bounds_ok, bounds = _xyz(event.get("bounds"), positive=True)
+    if not position_ok or not velocity_ok or not bounds_ok:
+        return _reject("invalid_motion")
+
+    if "through_portal" in event and not isinstance(event["through_portal"], bool):
+        return _reject("invalid_portal_flag")
+    through_portal = event.get("through_portal", False) is True
+    angle = None
+    if through_portal:
+        angle = event.get("angle")
+        if not _finite_number(angle):
+            return _reject("invalid_angle")
+    if not _event_log_ok(state):
+        return _reject("invalid_events")
+
+    # Calculate both vectors before cloning.  Reflection happens only when the
+    # candidate is outside the interval; landing exactly on a wall keeps speed.
+    next_position: dict[str, Any] = {}
+    next_velocity: dict[str, Any] = {}
+    for axis in _AXES:
+        candidate = position[axis] + velocity[axis]
+        component_velocity = velocity[axis]
+        if candidate > bounds[axis]:
+            candidate = bounds[axis]
+            component_velocity = -component_velocity
+        elif candidate < -bounds[axis]:
+            candidate = -bounds[axis]
+            component_velocity = -component_velocity
+        next_position[axis] = candidate
+        next_velocity[axis] = component_velocity
+
+    updated = _transaction(state, timestamp)
+    # The documented scenario uses ordinary dicts.  Keeping the explicit check
+    # makes malformed mappings reject rather than partially update a response.
+    copied_asteroids = updated.get("asteroids")
+    if not isinstance(copied_asteroids, dict):
+        return _reject("invalid_motion")
+    copied_asteroid = copied_asteroids.get(asteroid_id)
+    if not isinstance(copied_asteroid, dict):
+        return _reject("invalid_motion")
+    copied_asteroid["position"] = next_position
+    copied_asteroid["velocity"] = next_velocity
+
+    if through_portal:
+        updated.setdefault("events", []).append(
+            {"type": "portal_ripple", "asteroid_id": asteroid_id, "angle": angle}
+        )
+    return _accept(updated, {"position": next_position, "velocity": next_velocity})
+
+
+def _equip(state: dict[str, Any], event: dict[str, Any], timestamp: Any) -> _HandlerOutcome:
+    weapon_id = event.get("weapon_id")
+    found, _weapon = _mapping_value(state.get("weapons"), weapon_id)
+    if not found:
+        return _reject("unknown_weapon")
+
+    equipped = state.get("equipped", [])
+    if not isinstance(equipped, list):
+        return _reject("invalid_equipment")
+    if any(weapon_id == existing for existing in equipped):
+        return _reject("weapon_already_equipped")
+    if len(_distinct(equipped)) >= 2:
+        return _reject("weapon_limit")
+
+    updated = _transaction(state, timestamp)
+    updated.setdefault("equipped", []).append(deepcopy(weapon_id))
+    return _accept(updated, {"equipped": deepcopy(updated["equipped"])})
+
+
+def _activate_shield(
+    state: dict[str, Any], event: dict[str, Any], timestamp: Any
+) -> _HandlerOutcome:
+    energy = event.get("energy")
+    if not _nonnegative_number(energy):
+        return _reject("invalid_shield_energy")
+    updated = _transaction(state, timestamp)
+    updated["shield_energy"] = energy
+    return _accept(updated, {"shield_energy": energy})
+
+
+def _restart_inputs_error(state: dict[str, Any]) -> str | None:
+    """Return the first invalid restart field, or ``None`` when it is ready."""
+
+    # Keeping field-specific codes makes malformed synthetic states just as
+    # diagnosable as ordinary event validation while still validating before a
+    # transaction is opened.
+    if not _nonnegative_number(state.get("initial_lives")):
+        return "invalid_initial_lives"
+    if not isinstance(state.get("enemies", {}), dict):
+        return "invalid_enemies"
+    if not _valid_wave(state.get("wave", 0)):
+        return "invalid_wave_state"
+    snapshot = state.get("level_asteroids", state.get("asteroids", {}))
+    if not isinstance(snapshot, Mapping):
+        return "invalid_level_snapshot"
+    restart_count = state.get("restart_count", 0)
+    if not isinstance(restart_count, Integral) or isinstance(restart_count, bool):
+        return "invalid_restart_count"
+    if not _event_log_ok(state):
+        return "invalid_events"
+    if any(not isinstance(enemy, dict) for enemy in state.get("enemies", {}).values()):
+        return "invalid_enemy"
+    return None
+
+
+def _hit(state: dict[str, Any], event: dict[str, Any], timestamp: Any) -> _HandlerOutcome:
+    damage = event.get("damage")
+    if not _nonnegative_number(damage):
+        return _reject("invalid_damage")
+
+    shield_before = state.get("shield_energy", 0)
+    lives_before = state.get("lives")
+    if not _nonnegative_number(shield_before) or not _nonnegative_number(lives_before):
+        return _reject("invalid_life_state")
+
+    absorbed = min(damage, shield_before)
+    remainder = damage - absorbed
+    lives_after = lives_before
+    if remainder > 0:
+        # A hit costs one life, never a fractional or negative number of lives.
+        lives_after = max(0, lives_before - 1)
+    needs_restart = remainder > 0 and lives_after == 0
+    if needs_restart:
+        restart_error = _restart_inputs_error(state)
+        if restart_error is not None:
+            return _reject(restart_error)
+
+    updated = _transaction(state, timestamp)
+    updated["shield_energy"] = shield_before - absorbed
+    updated["lives"] = lives_after
+    if needs_restart and not _reset_level(updated):
+        # This is defensive; _restart_inputs_ok validated the source snapshot.
+        return _reject("invalid_restart_state")
+    return _accept(
+        updated,
+        {
+            "absorbed": absorbed,
+            "lives": updated.get("lives"),
+            "shield_energy": updated.get("shield_energy"),
+        },
+    )
+
+
+def _fire(state: dict[str, Any], event: dict[str, Any], timestamp: Any) -> _HandlerOutcome:
+    weapon_id = event.get("weapon_id")
+    enemy_id = event.get("enemy_id")
+    equipped = state.get("equipped", [])
+    if not isinstance(equipped, list) or not any(weapon_id == item for item in equipped):
+        return _reject("weapon_not_equipped")
+
+    found_weapon, weapon = _mapping_value(state.get("weapons"), weapon_id)
+    if not found_weapon or not isinstance(weapon, Mapping):
+        return _reject("unknown_weapon")
+    power = weapon.get("power")
+    if not _positive_number(power):
+        return _reject("invalid_weapon_power")
+
+    found_enemy, enemy = _mapping_value(state.get("enemies"), enemy_id)
+    if not found_enemy or not isinstance(enemy, dict):
+        return _reject("unknown_enemy")
+    hp = enemy.get("hp")
+    if not _positive_number(hp):
+        return _reject("enemy_not_living")
+    if not _event_log_ok(state):
+        return _reject("invalid_events")
+
+    new_hp = hp - power if hp > power else 0
+    updated = _transaction(state, timestamp)
+    copied_enemies = updated.get("enemies")
+    if not isinstance(copied_enemies, dict) or not isinstance(copied_enemies.get(enemy_id), dict):
+        return _reject("unknown_enemy")
+    copied_enemies[enemy_id]["hp"] = new_hp
+    updated.setdefault("events", []).append(
+        {"type": "shot", "weapon_id": weapon_id, "enemy_id": enemy_id}
+    )
+    return _accept(
+        updated,
+        {"weapon_id": weapon_id, "enemy_id": enemy_id, "hp": new_hp},
+    )
+
+
+def _wave_enemies(wave: Integral) -> dict[str, dict[str, Any]]:
+    """Create the deterministic renderable enemy ring for a wave."""
+
+    count = wave + 1
+    enemies: dict[str, dict[str, Any]] = {}
+    for index in range(count):
+        angle = 2 * math.pi * index / count
+        enemies[f"enemy_{index + 1}"] = {
+            "hp": count,
+            "position": {
+                "x": 1.55 * math.cos(angle),
+                "y": 0.55 * math.sin(angle),
+                "z": -0.8 - 0.15 * (index % 3),
+            },
+        }
+    return enemies
+
+
+def _spawn_wave(state: dict[str, Any], event: dict[str, Any], timestamp: Any) -> _HandlerOutcome:
+    requested_wave = event.get("wave")
+    current_wave = state.get("wave", 0)
+    if (
+        not isinstance(requested_wave, Integral)
+        or isinstance(requested_wave, bool)
+        or requested_wave <= 0
+        or not _valid_wave(current_wave)
+        or requested_wave <= current_wave
+    ):
+        return _reject("invalid_wave")
+
+    updated = _transaction(state, timestamp)
+    count = requested_wave + 1
+    updated["enemies"] = _wave_enemies(requested_wave)
+    updated["wave"] = requested_wave
+    return _accept(updated, {"count": count, "health": count})
+
+
+_HANDLERS = {
+    "transition": _transition,
+    "move_asteroid": _move_asteroid,
+    "equip": _equip,
+    "activate_shield": _activate_shield,
+    "hit": _hit,
+    "fire": _fire,
+    "spawn_wave": _spawn_wave,
+}
+
 
 def process_portal_event(state: dict, event: dict) -> dict:
-    raise NotImplementedError("Implement disclosed portal gameplay rules")
+    """Apply one portal event without mutating either caller-owned input.
+
+    Successful actions return a cloned state with the accepted timestamp and a
+    ``result`` summary.  Rejections clone the prior state and add a non-empty
+    ``error.code``; the gameplay fields and prior timestamp are untouched.
+    """
+
+    if not isinstance(state, dict):
+        return _error_state({}, "invalid_state")
+    if not isinstance(event, dict):
+        return _error_state(state, "invalid_event")
+
+    current_timestamp = state.get("timestamp", 0)
+    if not _finite_number(current_timestamp):
+        return _error_state(state, "invalid_state_timestamp")
+    if "timestamp" not in event or not _finite_number(event.get("timestamp")):
+        return _error_state(state, "invalid_timestamp")
+
+    timestamp = event["timestamp"]
+    try:
+        if timestamp < current_timestamp:
+            return _error_state(state, "timestamp_reversed")
+    except (TypeError, ValueError):
+        return _error_state(state, "invalid_timestamp")
+
+    event_type = event.get("type")
+    if not isinstance(event_type, str) or event_type not in _SUPPORTED_EVENTS:
+        return _error_state(state, "unknown_event")
+
+    handler = _HANDLERS[event_type]
+    updated, result, code = handler(state, event, timestamp)
+    if code is not None:
+        return _error_state(state, code)
+    # Every successful handler supplies both pieces.  The guard avoids leaking
+    # a malformed internal outcome as an exception for an unusual future event.
+    if updated is None or result is None:
+        return _error_state(state, "invalid_event_state")
+    return _finish(updated, result)
+
+
+__all__ = ["process_portal_event"]
