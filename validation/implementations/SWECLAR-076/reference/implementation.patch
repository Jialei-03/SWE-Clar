+        if not found or not isinstance(portal, Mapping) or portal.get("active") is not True:
+            return _copy_error_state(state, "invalid_portal")
+
+        new_state = _prepare_success(state, timestamp)
+        new_state["mode"] = target_mode
+        return _finish(
+            new_state,
+            {"mode": target_mode, "lives": deepcopy(new_state.get("lives"))},
+        )
+
+    if event_type == "move_asteroid":
