+"""Reference policy for the independent portal training arena.
+
+The browser transport keeps the complete scenario in a JSON-compatible mapping and
+calls :func:`process_portal_event` for each action.  The policy deliberately does
+not depend on the browser: it validates an action first, copies the scenario, and
+then applies one atomic change to that copy.
+"""
+
+from __future__ import annotations
+
+from copy import deepcopy
+import math
+from numbers import Integral
+from typing import Any, Mapping
+
+
+_AXES = ("x", "y", "z")
+_MODES = {"room", "cockpit"}
+
+
+def _finite_number(value: Any) -> bool:
+    """Return whether *value* is a finite number, excluding booleans.
+
+    ``bool`` is a subclass of ``int`` in Python, but timestamps and gameplay
+    quantities use the JSON numeric meaning of a value, not its truth value.
+    ``math.isfinite`` also keeps strings, ``None`` and complex values out.
+    """
+
+    if isinstance(value, bool):
+        return False
+    try:
+        return math.isfinite(value)
+    except (TypeError, ValueError, OverflowError):
+        return False
+
+
+def _positive_number(value: Any) -> bool:
+    if not _finite_number(value):
+        return False
+    try:
+        return value > 0
+    except (TypeError, ValueError):
+        return False
+
+
+def _nonnegative_number(value: Any) -> bool:
+    if not _finite_number(value):
+        return False
+    try:
+        return value >= 0
+    except (TypeError, ValueError):
+        return False
+
+
+def _mapping_value(mapping: Any, key: Any) -> tuple[bool, Any]:
+    """Safely look up a key in a mapping-like JSON object."""
+
+    if not isinstance(mapping, Mapping):
+        return False, None
+    try:
+        if key not in mapping:
+            return False, None
+        return True, mapping[key]
+    except (TypeError, KeyError):
+        # A malformed, unhashable identifier is simply an unknown identifier.
+        return False, None
+
+
+def _xyz(value: Any, *, positive: bool = False) -> tuple[bool, dict[str, Any]]:
+    """Validate and copy an x/y/z object."""
+
+    if not isinstance(value, Mapping):
+        return False, {}
+    result: dict[str, Any] = {}
+    for axis in _AXES:
+        if axis not in value:
+            return False, {}
+        component = value[axis]
+        if not (_positive_number(component) if positive else _finite_number(component)):
+            return False, {}
+        result[axis] = component
+    return True, result
+
+
+def _copy_error_state(state: Any, code: str) -> dict[str, Any]:
+    """Build a rejection without changing the caller's mapping."""
+
+    if isinstance(state, dict):
+        result = deepcopy(state)
+    else:
+        result = {}
+    result["error"] = {"code": code}
+    return result
+
+
+def _event_log_is_valid(state: Mapping[str, Any]) -> bool:
+    # The scenario schema uses a list.  Missing logs are handled as an empty
+    # list so small synthetic states can still exercise a ripple or shot.
+    return "events" not in state or isinstance(state.get("events"), list)
+
+
+def _distinct(values: list[Any]) -> list[Any]:
+    """Return distinct JSON-ish identifiers without requiring hashability."""
+
+    distinct: list[Any] = []
+    for value in values:
+        if not any(value == previous for previous in distinct):
+            distinct.append(value)
+    return distinct
+
+
+def _valid_wave_value(value: Any) -> bool:
+    return isinstance(value, Integral) and not isinstance(value, bool) and value >= 0
+
+
+def _restart_level(new_state: dict[str, Any]) -> bool:
+    """Apply the level restart part of a life-exhausting hit.
+
+    Callers validate the relevant state fields before entering this helper.  It
+    returns ``False`` defensively if a malformed mapping is encountered, so a
+    caller can still reject rather than partially applying a restart.
+    """
+
+    initial_lives = new_state.get("initial_lives")
+    if not _nonnegative_number(initial_lives):
+        return False
+
+    level_asteroids = new_state.get("level_asteroids")
+    if level_asteroids is None:
+        # The documented state always supplies this snapshot.  Falling back to
+        # the current asteroids is useful for a minimal synthetic state while
+        # retaining the same restart semantics when the snapshot is present.
+        level_asteroids = new_state.get("asteroids", {})
+    if not isinstance(level_asteroids, Mapping):
+        return False
+
+    current_wave = new_state.get("wave", 0)
+    if not _valid_wave_value(current_wave):
+        return False
+
+    enemies = new_state.get("enemies", {})
+    if not isinstance(enemies, dict):
+        return False
+
+    restart_count = new_state.get("restart_count", 0)
+    if not isinstance(restart_count, Integral) or isinstance(restart_count, bool):
+        return False
+
+    if not _event_log_is_valid(new_state):
+        return False
+
+    # These assignments are all made to the already independent copy.
+    new_state["lives"] = initial_lives
+    new_state["shield_energy"] = 0
+    new_state["asteroids"] = deepcopy(level_asteroids)
+    full_health = current_wave + 1
+    for enemy in enemies.values():
+        if not isinstance(enemy, dict):
+            return False
+        enemy["hp"] = full_health
+    new_state["restart_count"] = restart_count + 1
+    if "events" not in new_state:
+        new_state["events"] = []
+    new_state["events"].append({"type": "level_restart"})
+    return True
+
+
+def _prepare_success(state: dict[str, Any], timestamp: Any) -> dict[str, Any]:
+    """Copy state and install the accepted event timestamp."""
+
+    result = deepcopy(state)
+    # A rejected response is itself stored by the supplied HTTP transport.  Do
+    # not let its transport-only error leak into the next successful state.
+    result.pop("error", None)
+    result.pop("result", None)
+    result["timestamp"] = timestamp
+    return result
+
+
+def _finish(state: dict[str, Any], result: dict[str, Any]) -> dict[str, Any]:
+    state["result"] = deepcopy(result)
+    return state
+
 
 def process_portal_event(state: dict, event: dict) -> dict:
-    raise NotImplementedError("Implement disclosed portal gameplay rules")
+    """Process one portal-arena event atomically.
+
+    A successful return is a new state mapping with the event timestamp and a
+    small ``result`` object.  A failed return is a copy of the prior state with
+    a non-empty ``error.code``; importantly, the prior timestamp and all
+    gameplay fields remain unchanged.
+    """
+
+    if not isinstance(state, dict):
+        return _copy_error_state({}, "invalid_state")
+    if not isinstance(event, dict):
+        return _copy_error_state(state, "invalid_event")
+
+    current_timestamp = state.get("timestamp", 0)
+    if not _finite_number(current_timestamp):
+        return _copy_error_state(state, "invalid_state_timestamp")
+
+    if "timestamp" not in event or not _finite_number(event.get("timestamp")):
+        return _copy_error_state(state, "invalid_timestamp")
+    timestamp = event["timestamp"]
+    try:
+        if timestamp < current_timestamp:
+            return _copy_error_state(state, "timestamp_reversed")
+    except (TypeError, ValueError):
+        return _copy_error_state(state, "invalid_timestamp")
+
+    event_type = event.get("type")
+    if not isinstance(event_type, str) or event_type not in {
+        "transition",
+        "move_asteroid",
+        "equip",
+        "activate_shield",
+        "hit",
+        "fire",
+        "spawn_wave",
+    }:
+        return _copy_error_state(state, "unknown_event")
+
+    # Validate and then modify only this copy.  Any failed branch below returns
+    # a fresh copy of the original state instead.
+    new_state: dict[str, Any]
+
+    if event_type == "transition":
+        mode = state.get("mode")
+        target_mode = event.get("target_mode")
+        if (
+            not isinstance(mode, str)
+            or not isinstance(target_mode, str)
+            or mode not in _MODES
+            or target_mode not in _MODES
+            or target_mode == mode
+        ):
+            return _copy_error_state(state, "invalid_mode")
+
+        portals = state.get("portals")
