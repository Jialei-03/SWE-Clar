+const $ = selector => document.querySelector(selector);
+let selected = '';
+
+async function api(path, body) {
+  const response = await fetch(path, body === undefined ? {} : {
+    method: 'POST',
+    headers: {'Content-Type': 'application/json'},
+    body: JSON.stringify(body)
+  });
+  const value = await response.json();
+  if (!response.ok) throw Error(value.error);
+  return value;
+}
+
+function render(state) {
+  const available = new Set(state.devices.map(device => device.device_id));
+  if (selected && !available.has(selected)) selected = '';
+  if (!selected && state.connected && available.has(state.connected)) selected = state.connected;
+  $('#device').value = selected;
+
+  const list = $('#device-list');
+  list.replaceChildren();
+  for (const device of state.devices) {
+    const button = document.createElement('button');
+    button.dataset.device = device.device_id;
+    // textContent, rather than HTML parsing, keeps peer-provided names inert.
+    button.textContent = device.name + ' (' + device.device_id + ')';
+    button.onclick = () => {
+      selected = device.device_id;
+      $('#device').value = selected;
+    };
+    list.append(button);
+  }
+
+  $('#connection').textContent = state.connected === null ? 'Disconnected' : state.connected;
+  const telemetry = $('#telemetry');
+  telemetry.replaceChildren();
+  for (const packet of state.telemetry) {
+    const row = document.createElement('li');
+    row.dataset.device = packet.device_id;
+    row.dataset.packet = packet.packet_id;
+    row.textContent = packet.device_id + ' / ' + packet.packet_id + '\n' + JSON.stringify(packet.data);
+    telemetry.append(row);
+  }
+}
+
+async function action(path, body) {
+  try {
+    const result = await api(path, body);
+    if (path === '/api/command') $('#command-result').textContent = JSON.stringify(result.result);
+    render(await api('/api/state'));
+    $('#status').textContent = 'Operation complete';
+  } catch (error) {
+    $('#status').textContent = error.message;
+    try { render(await api('/api/state')); } catch (_) { /* keep the last browser state */ }
+  }
+}
+
+$('#scan').onclick = () => action('/api/scan', {service: $('#service').value});
+$('#pair').onclick = () => action('/api/pair', {device_id: selected, code: $('#pair-code').value});
