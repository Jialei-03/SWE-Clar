+*{box-sizing:border-box}
+body{font:17px/1.5 system-ui,sans-serif;background:#f5f5ef;color:#293832;margin:0}
+main{max-width:780px;margin:50px auto;padding:0 24px}
+.eyebrow{text-transform:uppercase;font-size:12px;letter-spacing:.1em}
+h1{font-size:42px;line-height:1.15}
+form,section{background:white;border:1px solid #d8dfd6;padding:26px}
+label{display:block;margin-bottom:18px}
+input{display:block;width:100%;font:inherit;padding:10px;margin-top:6px;border:1px solid #9aab9a}
+button{font:inherit;padding:10px 18px;background:#34583f;color:white;border:0;cursor:pointer}
+button:disabled{background:#a9b5aa;color:#eef1ec;cursor:not-allowed}
+.actions{display:flex;gap:12px;flex-wrap:wrap}
+#reset{background:#e2e8df;color:#293832}
+#error{min-height:1.5em;color:#8a3026}
+dl{display:grid;grid-template-columns:1fr auto;gap:12px}
+dd{font-weight:600;margin:0}
+#results[hidden]{display:none}
+@media(max-width:600px){main{margin:24px auto;padding:0 14px}h1{font-size:34px}form,section{padding:18px}dl{grid-template-columns:1fr;gap:4px}dd{margin-bottom:16px}}
