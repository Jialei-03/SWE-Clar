+def _validate_trigger(value, duration, previous):
+    """Validate a policy result and return it as a finite float."""
+    if isinstance(value, bool):
+        raise ValueError("invalid trigger timestamp")
+    try:
+        trigger = float(value)
+    except (TypeError, ValueError, OverflowError) as exc:
+        raise ValueError("invalid trigger timestamp") from exc
+    if not math.isfinite(trigger) or trigger < 0 or trigger >= duration:
+        raise ValueError("recording does not cover trigger")
+    if previous is not None and trigger < previous:
+        raise ValueError("triggers are not chronological")
+    return trigger
+
+
+def _encode_clip(recording, destination, start, end, ffmpeg):
+    """Encode one real recording interval as a playable MP4."""
+    length = end - start
+    if not math.isfinite(length) or length <= 0:
+        raise ValueError("invalid clip interval")
+
+    # Seeking after the input makes the cut accurate even when the source has
+    # sparse keyframes.  The benchmark clips are short, so decoding up to the
+    # requested start is preferable to introducing keyframe-dependent offsets.
+    command = [
+        str(ffmpeg),
+        "-v",
+        "error",
+        "-y",
+        "-i",
+        str(recording),
+        "-ss",
+        f"{start:.9f}",
+        "-t",
+        f"{length:.9f}",
+        "-map",
+        "0:v:0",
+        "-an",
+        "-c:v",
+        "mpeg4",
+        "-q:v",
+        "2",
+        "-threads",
+        "1",
+        "-pix_fmt",
+        "yuv420p",
+        "-map_metadata",
+        "-1",
+        "-movflags",
+        "+faststart",
+        str(destination),
+    ]
+    subprocess.run(command, capture_output=True, timeout=30, check=True)
+
+    payload = destination.read_bytes()
+    # FFmpeg succeeding is normally sufficient, but explicitly reject an
+    # empty/non-MP4 result before it can be delivered or committed.
+    if len(payload) < 8 or payload[4:8] != b"ftyp":
+        raise ValueError("encoder did not produce an MP4")
+    return payload
+
+
+def _deliver(delivery_url, payload, clip_id):
+    """POST payload and require the adapter's accepted, matching response."""
+    digest = hashlib.sha256(payload).hexdigest()
+    request = Request(
+        str(delivery_url),
+        data=payload,
+        headers={
+            "Content-Type": "video/mp4",
+            "X-Content-SHA256": digest,
+            "X-Clip-ID": str(clip_id),
+        },
+        method="POST",
+    )
+    with urlopen(request, timeout=30) as response:
+        response_data = response.read()
+    try:
+        acknowledgement = json.loads(response_data.decode("utf-8"))
+    except (UnicodeDecodeError, json.JSONDecodeError) as exc:
+        raise ValueError("invalid delivery response") from exc
+    if (
+        not isinstance(acknowledgement, dict)
+        or acknowledgement.get("accepted") is not True
+        or acknowledgement.get("sha256") != digest
+    ):
+        raise ValueError("delivery was not accepted with the matching digest")
+    return digest
+
+
