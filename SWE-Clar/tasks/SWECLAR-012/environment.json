{
  "profile": "flutter-component",
  "flutter_workspace_setup": true,
  "resources": {
    "cpus": 2,
    "memory_mb": 2048,
    "pids": 256,
    "network": "none except loopback",
    "workspace_mb": 512,
    "evaluation_wall_seconds": 300
  },
  "workdir": "/workspace",
  "public_test": [
    "python",
    "/public_tests/test_public.py"
  ],
  "start": [
    "python",
    "/public_tests/run_clinic.py",
    "--script",
    "session.json",
    "--output",
    "/tmp/clinic-preview"
  ],
  "preflight": [
    "python",
    "/opt/sweclar/preflight.py"
  ],
  "task_preflight": [
    "python",
    "/public_tests/preflight.py",
    "--prepare-workspace"
  ],
  "prepare_owner": "benchmark before candidate budget",
  "platform": "linux/amd64"
}
