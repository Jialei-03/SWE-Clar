{
  "profile": "python-practice",
  "platform": "linux/amd64",
  "resources": {
    "cpus": 2,
    "memory_mb": 2048,
    "pids": 256,
    "network": "none except loopback",
    "workspace_mb": 512,
    "evaluation_wall_seconds": 300
  },
  "workdir": "/workspace",
  "public_test": [
    "python",
    "/public_tests/test_public.py"
  ],
  "build": [
    "node",
    "build.mjs",
    "runtime/dist"
  ],
  "start": [
    "python",
    "-m",
    "http.server",
    "8080",
    "--bind",
    "127.0.0.1",
    "--directory",
    "runtime/dist"
  ],
  "preflight": [
    "python",
    "/opt/sweclar/preflight.py"
  ],
  "task_preflight": [
    "python",
    "/public_tests/preflight.py"
  ],
  "prepare_owner": "benchmark before candidate budget"
}
