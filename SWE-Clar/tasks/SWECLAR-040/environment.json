{
  "profile": "node-sdk",
  "platform": "linux/amd64",
  "resources": {
    "cpus": 2,
    "memory_mb": 2048,
    "pids": 256,
    "network": "none except loopback",
    "workspace_mb": 256,
    "evaluation_wall_seconds": 180
  },
  "workdir": "/workspace",
  "public_test": [
    "node",
    "/public_tests/test_public.cjs"
  ],
  "preflight": [
    "python",
    "-I",
    "/opt/sweclar/preflight.py"
  ],
  "task_preflight": [
    "python",
    "/public_tests/preflight.py"
  ],
  "prepare_owner": "benchmark before candidate budget",
  "start": [
    "sh",
    "-c",
    "CATALOG_CONFIG=runtime/config.json CATALOG_STATE=runtime/state.json node server.cjs"
  ]
}
