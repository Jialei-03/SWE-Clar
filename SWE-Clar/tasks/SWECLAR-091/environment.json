{
  "profile": "native-wx",
  "platform": "linux/amd64",
  "resources": {
    "cpus": 2,
    "memory_mb": 2048,
    "pids": 256,
    "network": "none except loopback",
    "workspace_mb": 256,
    "evaluation_wall_seconds": 360
  },
  "workdir": "/workspace",
  "public_test": [
    "python",
    "/public_tests/test_public.py"
  ],
  "start": [
    "sh",
    "-c",
    "cmake -S . -B build && cmake --build build --parallel 2 && xvfb-run -a ./build/workspace_gui --smoke"
  ],
  "preflight": [
    "python",
    "/opt/sweclar/preflight.py"
  ],
  "task_preflight": [
    "python",
    "/public_tests/preflight.py"
  ],
  "prepare_owner": "benchmark before candidate budget"
}
