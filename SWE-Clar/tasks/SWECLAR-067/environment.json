{
  "profile": "python-web",
  "platform": "linux/amd64",
  "resources": {
    "cpus": 2,
    "memory_mb": 2048,
    "pids": 256,
    "network": "none except loopback",
    "workspace_mb": 256,
    "evaluation_wall_seconds": 180
  },
  "workdir": "/workspace",
  "public_test": [
    "python",
    "/public_tests/test_public.py"
  ],
  "start": [
    "python",
    "/public_tests/serve.py",
    "--project",
    "/workspace",
    "--port",
    "8080"
  ],
  "preflight": [
    "python",
    "/opt/sweclar/preflight.py"
  ],
  "prepare_owner": "benchmark before candidate budget"
}
