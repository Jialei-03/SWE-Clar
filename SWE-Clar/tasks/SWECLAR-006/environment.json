{
  "profile": "flutter-component",
  "resources": {
    "cpus": 2,
    "memory_mb": 2048,
    "pids": 256,
    "network": "none except loopback",
    "workspace_mb": 512,
    "evaluation_wall_seconds": 660
  },
  "workdir": "/workspace",
  "public_test": [
    "python",
    "/public_tests/test_public.py"
  ],
  "start": [
    "python",
    "/public_tests/run_booking.py",
    "--script",
    "session.json",
    "--output",
    "/tmp/booking-preview"
  ],
  "preflight": [
    "python",
    "/opt/sweclar/preflight.py"
  ],
  "prepare_owner": "benchmark, before agent budget",
  "platform": "linux/amd64"
}
