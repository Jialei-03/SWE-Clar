{
  "profile": "python-audio",
  "resources": {
    "cpus": 2,
    "memory_mb": 2048,
    "pids": 256,
    "network": "none",
    "workspace_mb": 512,
    "evaluation_wall_seconds": 240
  },
  "workdir": "/workspace",
  "public_test": [
    "python",
    "-I",
    "/public_tests/test_public.py"
  ],
  "start": [
    "python",
    "app.py",
    "<input directory>",
    "<output directory>",
    "--seed",
    "0",
    "--articulation",
    "normal"
  ],
  "preflight": [
    "python",
    "-I",
    "/opt/sweclar/preflight.py"
  ],
  "prepare_owner": "benchmark, before agent budget",
  "platform": "linux/amd64"
}
