{
  "profile": "python-game",
  "resources": {
    "cpus": 2,
    "memory_mb": 2048,
    "pids": 256,
    "network": "none except loopback",
    "workspace_mb": 512,
    "evaluation_wall_seconds": 240
  },
  "workdir": "/workspace",
  "public_test": [
    "python",
    "-I",
    "/public_tests/test_public.py"
  ],
  "start": [
    "python",
    "server.py",
    "--port",
    "0",
    "--db",
    "<isolated database>"
  ],
  "preflight": [
    "python",
    "-I",
    "/opt/sweclar/preflight.py"
  ],
  "prepare_owner": "benchmark, before agent budget",
  "platform": "linux/amd64"
}
